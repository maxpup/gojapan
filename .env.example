# Required: provider/model. The provider must have a matching key below.
GOJAPAN_AI_PRIMARY=openai/your-model-id
# Optional comma-separated fallback chain.
GOJAPAN_AI_FALLBACKS=anthropic/your-model-id

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com

